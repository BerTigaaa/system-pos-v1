# ── Database ──
DATABASE_URL="postgresql://user:password@localhost:5432/bertigapos"

# ── NextAuth ──
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key"

# ── App Config ──
NEXT_PUBLIC_APP_NAME="BertigaPos"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Trial ──
TRIAL_DURATION_DAYS=14

# ── Cloudflare Images ──
# Diisi jika menggunakan upload foto produk via Cloudflare Images
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_IMAGES_API_TOKEN=""
CLOUDFLARE_IMAGES_ACCOUNT_HASH=""

# ── Email (Resend) ──
# Diisi jika menggunakan notifikasi email
RESEND_API_KEY=""
EMAIL_FROM="noreply@bertigapos.com"

# ── QR Code ──
# API eksternal untuk generate QR code struk
NEXT_PUBLIC_QR_API_URL="https://api.qrserver.com/v1/create-qr-code/"

# ── WhatsApp ──
# Nomor WhatsApp untuk trial / kontak (termasuk kode negara, tanpa +)
NEXT_PUBLIC_WHATSAPP_NUMBER="6281234567890"

# ── Internal ──
# Password default untuk reset password karyawan
DEFAULT_EMPLOYEE_PASSWORD="password123"
