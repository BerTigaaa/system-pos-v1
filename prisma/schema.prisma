generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  TRIAL
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  CASHIER
  WAREHOUSE
  FINANCE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QRIS
  BANK_TRANSFER
  DEBIT_CARD
  CREDIT_CARD
}

enum InventoryMovementType {
  PURCHASE
  SALE
  MANUAL_OUT
  ADJUSTMENT
  OPNAME
  RETURN
}

enum CashFlowType {
  IN
  OUT
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  TRIAL_EXPIRING
  ACCOUNT_EXPIRING
  REFUND_SUCCESS
  STOCK_ADJUSTED
  PRODUCT_ADDED
  SETTINGS_CHANGED
  NEW_LOGIN
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  password      String
  role          UserRole
  phone         String?
  avatarUrl     String?       @map("avatar_url")
  isActive      Boolean       @default(true) @map("is_active")
  status        AccountStatus @default(TRIAL)
  trialStartDate DateTime?    @map("trial_start_date")
  trialEndDate  DateTime?     @map("trial_end_date")
  lastLoginAt   DateTime?     @map("last_login_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  transactions  Transaction[] @relation("CashierTransactions")
  shifts        Shift[]
  auditLogs     AuditLog[]
  notifications Notification[]
  inventoryMovements InventoryMovement[]
  cashFlows     CashFlow[]
  stockOpnames  StockOpname[]

  @@index([email])
  @@map("users")
}

model BusinessInfo {
  id          String   @id @default(uuid())
  name        String
  ownerName   String   @map("owner_name")
  address     String?
  phone       String?
  email       String?
  logoUrl     String?  @map("logo_url")
  npwp        String?
  selfOrderEnabled Boolean @default(false) @map("self_order_enabled")
  totalTables Int     @default(0) @map("total_tables")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  diningTables DiningTable[]

  @@map("business_info")
}

model DiningTable {
  id          String   @id @default(uuid())
  businessInfoId String @map("business_info_id")
  tableNumber Int      @map("table_number")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  businessInfo BusinessInfo @relation(fields: [businessInfoId], references: [id], onDelete: Cascade)

  @@unique([businessInfoId, tableNumber])
  @@map("dining_tables")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products    Product[]

  @@map("categories")
}

model Product {
  id           String   @id @default(uuid())
  categoryId   String?  @map("category_id")
  name         String
  sku          String   @unique
  barcode      String?  @unique
  description  String?
  imageUrl     String?  @map("image_url")
  unit         String   @default("pcs")
  buyPrice     Decimal  @default(0) @map("buy_price") @db.Decimal(12, 2)
  sellPrice    Decimal  @map("sell_price") @db.Decimal(12, 2)
  stock        Int      @default(0)
  minStock     Int      @default(5) @map("min_stock")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  category          Category?          @relation(fields: [categoryId], references: [id])
  transactionItems  TransactionItem[]
  inventoryMovements InventoryMovement[]
  stockOpnameItems  StockOpnameItem[]
  orderItems        OrderItem[]

  @@index([isActive])
  @@index([categoryId])
  @@map("products")
}

model Supplier {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  inventoryMovements  InventoryMovement[]

  @@map("suppliers")
}



model Shift {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  status          ShiftStatus @default(OPEN)
  openingBalance  Decimal     @default(0) @map("opening_balance") @db.Decimal(12, 2)
  closingBalance  Decimal?    @map("closing_balance") @db.Decimal(12, 2)
  totalCash       Decimal     @default(0) @map("total_cash") @db.Decimal(12, 2)
  totalQris       Decimal     @default(0) @map("total_qris") @db.Decimal(12, 2)
  totalTransfer   Decimal     @default(0) @map("total_transfer") @db.Decimal(12, 2)
  totalCard       Decimal     @default(0) @map("total_card") @db.Decimal(12, 2)
  totalSales      Decimal     @default(0) @map("total_sales") @db.Decimal(12, 2)
  totalTransactions Int       @default(0) @map("total_transactions")
  openedAt        DateTime    @default(now()) @map("opened_at")
  closedAt        DateTime?   @map("closed_at")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")

  user          User          @relation(fields: [userId], references: [id])
  transactions  Transaction[]
  orders        Order[]

  @@index([userId, status])
  @@map("shifts")
}

model Transaction {
  id              String            @id @default(uuid())
  invoiceNumber   String            @unique @map("invoice_number")
  shiftId         String?           @map("shift_id")
  cashierId       String            @map("cashier_id")
  customerName    String?           @map("customer_name")
  status          TransactionStatus @default(COMPLETED)
  subtotal        Decimal           @db.Decimal(12, 2)
  discountAmount  Decimal           @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxPercent      Decimal           @default(0) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount       Decimal           @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total           Decimal           @db.Decimal(12, 2)
  notes           String?
  tableNumber     Int?              @map("table_number")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  shift             Shift?             @relation(fields: [shiftId], references: [id])
  cashier           User               @relation("CashierTransactions", fields: [cashierId], references: [id])
  items             TransactionItem[]
  payments          TransactionPayment[]
  refunds           Refund[]

  @@index([cashierId])
  @@index([createdAt])
  @@index([status])
  @@map("transactions")
}

model TransactionItem {
  id            String   @id @default(uuid())
  transactionId String   @map("transaction_id")
  productId     String   @map("product_id")
  productName   String   @map("product_name")
  productSku    String   @map("product_sku")
  buyPrice      Decimal  @map("buy_price") @db.Decimal(12, 2)
  sellPrice     Decimal  @map("sell_price") @db.Decimal(12, 2)
  quantity      Int
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product      @relation(fields: [productId], references: [id])
  refundItems   RefundItem[]

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

model TransactionPayment {
  id              String        @id @default(uuid())
  transactionId   String        @map("transaction_id")
  method          PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  reference       String?
  changeAmount    Decimal       @default(0) @map("change_amount") @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at")

  transaction     Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("transaction_payments")
}

model Refund {
  id              String   @id @default(uuid())
  transactionId   String   @map("transaction_id")
  refundNumber    String   @map("refund_number")
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
  reason          String
  processedById   String   @map("processed_by_id")
  createdAt       DateTime @default(now()) @map("created_at")

  transaction     Transaction  @relation(fields: [transactionId], references: [id])
  items           RefundItem[]

  @@index([transactionId])
  @@map("refunds")
}

model RefundItem {
  id                  String   @id @default(uuid())
  refundId            String   @map("refund_id")
  transactionItemId   String   @map("transaction_item_id")
  quantity            Int
  amount              Decimal  @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  refund              Refund          @relation(fields: [refundId], references: [id], onDelete: Cascade)
  transactionItem     TransactionItem @relation(fields: [transactionItemId], references: [id])

  @@index([refundId])
  @@map("refund_items")
}

model InventoryMovement {
  id            String                @id @default(uuid())
  productId     String                @map("product_id")
  userId        String                @map("user_id")
  supplierId    String?               @map("supplier_id")
  type          InventoryMovementType
  quantity      Int
  stockBefore   Int                   @map("stock_before")
  stockAfter    Int                   @map("stock_after")
  buyPrice      Decimal?              @map("buy_price") @db.Decimal(12, 2)
  referenceId   String?               @map("reference_id")
  referenceType String?               @map("reference_type")
  reason        String?
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at")

  product   Product   @relation(fields: [productId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

model StockOpname {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  notes         String?
  isAdjusted    Boolean  @default(false) @map("is_adjusted")
  createdAt     DateTime @default(now()) @map("created_at")
  adjustedAt    DateTime? @map("adjusted_at")

  user          User             @relation(fields: [userId], references: [id])
  items         StockOpnameItem[]

  @@map("stock_opnames")
}

model StockOpnameItem {
  id            String      @id @default(uuid())
  opnameId      String      @map("opname_id")
  productId     String      @map("product_id")
  systemStock   Int         @map("system_stock")
  physicalStock Int         @map("physical_stock")
  difference    Int
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")

  opname        StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])

  @@index([opnameId])
  @@map("stock_opname_items")
}

model CashFlowCategory {
  id          String       @id @default(uuid())
  name        String
  type        CashFlowType
  isDefault   Boolean      @default(false) @map("is_default")
  createdAt   DateTime     @default(now()) @map("created_at")

  cashFlows   CashFlow[]

  @@unique([name, type])
  @@map("cash_flow_categories")
}

model CashFlow {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  categoryId  String       @map("category_id")
  type        CashFlowType
  amount      Decimal      @db.Decimal(12, 2)
  description String
  reference   String?
  date        DateTime     @db.Date
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  user        User             @relation(fields: [userId], references: [id])
  category    CashFlowCategory @relation(fields: [categoryId], references: [id])

  @@index([type])
  @@index([date])
  @@map("cash_flows")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  action      String
  module      String
  description String
  oldData     Json?    @map("old_data")
  newData     Json?    @map("new_data")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Order {
  id           String      @id @default(uuid())
  tableNumber  Int         @map("table_number")
  customerName String      @map("customer_name")
  notes        String?
  status       OrderStatus @default(PENDING)
  total        Decimal     @db.Decimal(12, 2)

  items   OrderItem[]
  shiftId String?   @map("shift_id")
  shift   Shift?    @relation(fields: [shiftId], references: [id])

  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([shiftId])
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  productId   String  @map("product_id")
  productName String  @map("product_name")
  quantity    Int
  sellPrice   Decimal @db.Decimal(12, 2) @map("sell_price")
  subtotal    Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  message     String
  isRead      Boolean          @default(false) @map("is_read")
  data        Json?
  createdAt   DateTime         @default(now()) @map("created_at")
  readAt      DateTime?        @map("read_at")

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
